    "design:gen": "node tools/design-gen/gen.mjs",
    "design:check": "node tools/design-gen/check.mjs",
    "typecheck": "tsc -p workbench/tsconfig.json",
    "design:snap": "node tools/snap/snap.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
