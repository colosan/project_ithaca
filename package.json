{
  "name": "ithaca-writer",
  "private": true,
  "type": "module",
  "description": "Ithaca — open-source writing studio for serial fiction. Repo root: design workbench + generators.",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "wb": "vite --config workbench/vite.config.ts",
